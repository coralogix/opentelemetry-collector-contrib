SELECT
{{- if .toplevel }}
  calls,
  datname,
  shared_blks_dirtied,
  shared_blks_hit,
  shared_blks_read,
  shared_blks_written,
  temp_blks_read,
  temp_blks_written,
  query,
  queryid::TEXT,
  userid::TEXT,
  COALESCE(rolname, '') AS rolname,
  rows::TEXT,
  total_exec_time,
  total_plan_time,
  toplevel::TEXT
{{- if .statsSince }},
  (EXTRACT(EPOCH FROM stats_since) * 1000000)::BIGINT::TEXT AS stats_since
{{- end }}
{{- else }}
  SUM(calls) AS calls,
  datname,
  SUM(shared_blks_dirtied) AS shared_blks_dirtied,
  SUM(shared_blks_hit) AS shared_blks_hit,
  SUM(shared_blks_read) AS shared_blks_read,
  SUM(shared_blks_written) AS shared_blks_written,
  SUM(temp_blks_read) AS temp_blks_read,
  SUM(temp_blks_written) AS temp_blks_written,
  MAX(query) AS query,
  queryid::TEXT,
  userid::TEXT,
  COALESCE(rolname, '') AS rolname,
  SUM(rows)::TEXT AS rows,
  SUM(total_exec_time) AS total_exec_time,
  SUM(total_plan_time) AS total_plan_time
{{- end }}
FROM
  pg_stat_statements as pg_stat_statements
  LEFT JOIN pg_roles ON pg_stat_statements.userid = pg_roles.oid
  INNER JOIN pg_database ON pg_stat_statements.dbid = pg_database.oid
WHERE
  datname IS NOT NULL
  AND query != '<insufficient privilege>'
  AND query NOT LIKE '/* otel-collector-ignore */%'
  {{- if .excludedDatabases }}
  AND datname NOT IN ({{ .excludedDatabases }})
  {{- end }}
{{- if not .toplevel }}
GROUP BY pg_stat_statements.userid, pg_stat_statements.dbid, pg_stat_statements.queryid, datname, rolname
{{- end }}
ORDER BY calls DESC
LIMIT {{ .limit }};